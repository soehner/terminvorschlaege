{
  "manifest_version": 3,
  "name": "Terminvorschläge",
  "description": "Erzeugt aus freien Kalenderzeiten Terminvorschläge in E-Mails, reserviert sie im Kalender und wertet Bestätigungen automatisch aus – inkl. Videokonferenz-Link.",
  "version": "1.5.0",
  "author": "Jörg Söhner",
  "homepage_url": "https://github.com/soehner/terminvorschlaege",
  "browser_specific_settings": {
    "gecko": {
      "id": "terminvorschlaege@soehner.local",
      "strict_min_version": "128.0",
      "strict_max_version": "162.*"
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "background": {
    "scripts": [
      "lib/defaults.js",
      "lib/util.js",
      "lib/slots.js",
      "lib/ics.js",
      "lib/calendar.js",
      "lib/video.js",
      "background.js"
    ]
  },
  "compose_action": {
    "default_title": "Terminvorschläge",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html",
    "default_area": "maintoolbar"
  },
  "message_display_action": {
    "default_title": "Terminvorschlag bestätigen",
    "default_icon": "icons/icon.svg",
    "default_popup": "confirm/confirm.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity",
    "compose",
    "compose.send",
    "messagesRead",
    "accountsRead",
    "scripting"
  ],
  "optional_host_permissions": ["*://*/*"],
  "experiment_apis": {
    "calendar_calendars": {
      "schema": "experiments/calendar/schema/calendar-calendars.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-calendars.js",
        "paths": [["calendar", "calendars"]]
      }
    },
    "calendar_items": {
      "schema": "experiments/calendar/schema/calendar-items.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-items.js",
        "paths": [["calendar", "items"]]
      }
    },
    "calendar_provider": {
      "schema": "experiments/calendar/schema/calendar-provider.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-provider.js",
        "events": ["startup"],
        "paths": [["calendar", "provider"]]
      }
    }
  }
}
