{
  "manifest_version": 3,
  "name": "Terminvorschläge",
  "description": "Erzeugt aus freien Kalenderzeiten Terminvorschläge in E-Mails, reserviert sie im Kalender und wertet Bestätigungen automatisch aus – inkl. Videokonferenz-Link.",
  "version": "1.3.2",
  "author": "Jörg Söhner",
  "browser_specific_settings": {
    "gecko": {
      "id": "terminvorschlaege@soehner.local",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "background": {
    "scripts": [
      "lib/defaults.js",
      "lib/util.js",
      "lib/slots.js",
      "lib/ics.js",
      "lib/video.js",
      "background.js"
    ]
  },
  "compose_action": {
    "default_title": "Terminvorschläge",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html",
    "default_area": "maintoolbar"
  },
  "message_display_action": {
    "default_title": "Terminvorschlag bestätigen",
    "default_icon": "icons/icon.svg",
    "default_popup": "confirm/confirm.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity",
    "compose",
    "compose.send",
    "messagesRead",
    "accountsRead",
    "scripting"
  ],
  "optional_host_permissions": ["*://*/*"],
  "experiment_apis": {
    "terminCalendar": {
      "schema": "api/terminCalendar/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["terminCalendar"]],
        "script": "api/terminCalendar/implementation.js"
      }
    }
  }
}
